<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>UziStormwerkzElcanScope</AssemblyName>
    <RootNamespace>Xidong.UZI.ELCAN</RootNamespace>
    <!--
      兼容性：服务端 SPT 4.1.5 公开仓库最高 tag 为 4.1.2（4.1.3/4.1.4/4.1.5 未发布公开 tag），
      钉到 4.1.2 是当前最稳的策略；服务端校验 mod 编译引用的 SPTarkov.Server.Core
      AssemblyVersion，使用 4.1.2 编译的 mod 可被 4.1.5 宿主加载。
    -->
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.2" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.2" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" />
  </ItemGroup>

</Project>
